# Maintainer: Jordan Callicoat <jordan dot callicoat at gmail dot com>

pkgname=imgview
pkgver=1.3.1
pkgrel=1
pkgdesc='Image viewer for close inspection of pixels and metadata (Qt 6)'
arch=('x86_64' 'aarch64')
url='https://github.com/JCallicoat/imgview'
license=('MIT')
depends=('qt6-base' 'exiv2' 'gcc-libs' 'glibc')
makedepends=('cmake')
optdepends=('qt6-imageformats: TIFF, WebP, TGA, ICNS, WBMP and JPEG 2000 support'
            'qt6-svg: SVG support')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f2a7d89de258eca49cd7d2cab10e711b6f4021c0717e24b31d75bf01b2a08f30')

build() {
  # CMAKE_BUILD_TYPE=None so makepkg's CFLAGS/CXXFLAGS/LDFLAGS are used as-is.
  # qt_standard_project_setup() adds an $ORIGIN-relative RPATH meant for
  # relocatable installs; a /usr system package doesn't need it.
  cmake -B build -S "$pkgname-$pkgver" \
    -DCMAKE_BUILD_TYPE='None' \
    -DCMAKE_INSTALL_PREFIX='/usr' \
    -DCMAKE_SKIP_INSTALL_RPATH=ON \
    -Wno-dev
  cmake --build build
}

package() {
  # Installs /usr/bin/imgview, the /usr/bin/iv symlink and
  # /usr/share/applications/imgview.desktop.
  DESTDIR="$pkgdir" cmake --install build
  # MIT requires shipping the license text.
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
