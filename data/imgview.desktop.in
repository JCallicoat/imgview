[Desktop Entry]
Type=Application
Name=imgview
GenericName=Image Viewer
Comment=Inspect image pixels and metadata
Keywords=image;picture;viewer;exif;metadata;pixel;
Exec=@IMGVIEW_INSTALL_BINARY@ %F
TryExec=@IMGVIEW_INSTALL_BINARY@
Icon=image-x-generic
Terminal=false
# Started from a menu (no file), it opens a file picker. %F: several files
# opened together are passed at once, and ←/→ then step through just those.
Categories=Graphics;Viewer;Qt;
StartupWMClass=imgview
# Image types handled by Qt's own image plugins (Qt GUI built-ins, Qt Image
# Formats, Qt SVG), whether or not each plugin is installed on this system.
# Video types the plugins also register (video/mj2, video/x-mng) and the
# Apple-only HEIF plugin's types are deliberately left out.
MimeType=image/bmp;image/gif;image/jpeg;image/png;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-xbitmap;image/x-xpixmap;image/vnd.microsoft.icon;image/svg+xml;image/svg+xml-compressed;image/x-icns;image/jp2;image/jpx;image/jpm;image/x-tga;image/tiff;image/vnd.wap.wbmp;image/webp;
